<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>GalaxyGenerationOverhaul</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <DebugType>none</DebugType>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Distant Worlds 2</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DistantWorlds.Types">
      <HintPath>$(GameDir)\DistantWorlds.Types.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="DistantWorlds.Core">
      <HintPath>$(GameDir)\DistantWorlds.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="DistantWorlds.UI">
      <HintPath>$(GameDir)\DistantWorlds.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Stride.Core.Mathematics">
      <HintPath>$(GameDir)\Stride.Core.Mathematics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Stride.Graphics">
      <HintPath>$(GameDir)\Stride.Graphics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>


</Project>
